rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Active status check via Firebase Custom Claims with fallback to admin profile document
    function isActive() {
      return isAuthenticated() && (
        request.auth.token.get('status', '') == 'active' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('status', 'active') == 'active')
      );
    }

    // Role check via Firebase Custom Claims with fallback to admin profile document
    function isSuperAdmin() {
      return (isActive() && request.auth.token.get('role', '') == 'super_admin') ||
        (isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super_admin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('status', 'active') != 'suspended');
    }

    // Map module and action to short code (e.g. products.view -> prd:v)
    function permCode(module, action) {
      let m = module == 'products' ? 'prd' :
              module == 'purchases' ? 'pur' :
              module == 'movements' ? 'mov' :
              module == 'sales' ? 'sal' :
              module == 'returns' ? 'ret' :
              module == 'inquiries' ? 'inq' :
              module == 'locations' ? 'loc' :
              module == 'brands' ? 'brd' :
              module == 'team' ? 'tem' :
              module == 'portfolio' ? 'prt' :
              module == 'reports' ? 'rep' :
              module == 'archive' ? 'arc' :
              module == 'users' ? 'usr' : module;
      let a = action == 'view' ? 'v' :
              action == 'add' ? 'a' :
              action == 'edit' ? 'e' :
              action == 'delete' ? 'd' :
              action == 'transfer' ? 't' :
              action == 'adjustment' ? 'j' :
              action == 'repair' ? 'r' :
              action == 'melt' ? 'm' :
              action == 'export' ? 'x' :
              action == 'zeroBalance' ? 'z' :
              action == 'uploadArchive' ? 'u' : action;
      return m + ':' + a;
    }

    // Granular permission check via Firebase Custom Claims with fallback to admin doc permissions
    function hasPermission(module, action) {
      return isSuperAdmin() || (
        isActive() && (
          (request.auth.token.get('perms', []).hasAny([permCode(module, action)])) ||
          (request.auth.token.get('permissions', {}).get(module, {}).get(action, false) == true) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('permissions', {}).get(module, {}).get(action, false) == true)
        )
      );
    }

    // Function to validate inquiry submissions and block bloated payloads
    function isValidInquiry() {
      let data = request.resource.data;
      return data.keys().hasAll(['firstName', 'lastName', 'countryCode', 'mobile', 'message', 'inquiryType', 'status', 'createdAt'])
        && data.keys().hasOnly(['firstName', 'lastName', 'countryCode', 'mobile', 'message', 'inquiryType', 'status', 'createdAt', 'middleName', 'email', 'company', 'gstinPan'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 100
        && data.countryCode is string && data.countryCode.size() > 0 && data.countryCode.size() < 10
        && data.mobile is string && data.mobile.size() >= 7 && data.mobile.size() <= 15
        && data.message is string && data.message.size() > 0 && data.message.size() < 5000
        && data.inquiryType is string && data.inquiryType.size() > 0 && data.inquiryType.size() <= 50
        && data.status == 'unread'
        && data.createdAt == request.time
        && (!('middleName' in data) || (data.middleName is string && data.middleName.size() < 100))
        && (!('email' in data) || (data.email is string && data.email.size() < 200))
        && (!('company' in data) || (data.company is string && data.company.size() < 200))
        && (!('gstinPan' in data) || (data.gstinPan is string && data.gstinPan.size() < 20));
    }

    // Admins Collection - Super Admin can view and manage profiles; staff can read own profile
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // Publicly readable marketing collections (Granular admin write only)
    match /team/{document=**} {
      allow read: if true;
      allow create: if hasPermission('team', 'add');
      allow update: if hasPermission('team', 'edit');
      allow delete: if hasPermission('team', 'delete');
    }
    match /brands/{document=**} {
      allow read: if true;
      allow create: if hasPermission('brands', 'add');
      allow update: if hasPermission('brands', 'edit');
      allow delete: if hasPermission('brands', 'delete');
    }
    match /portfolio/{document=**} {
      allow read: if true;
      allow create: if hasPermission('portfolio', 'add');
      allow update: if hasPermission('portfolio', 'edit');
      allow delete: if hasPermission('portfolio', 'delete');
    }
    match /insights/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Secure PII Inquiries Collection (Public create only with validation, Granular admin read/write)
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if hasPermission('inquiries', 'view');
      allow update: if hasPermission('inquiries', 'edit');
      allow delete: if hasPermission('inquiries', 'delete');
    }

    // Locations (Granular admin permission to read and manage)
    match /locations/{document=**} {
      allow read: if hasPermission('locations', 'view');
      allow create: if hasPermission('locations', 'add');
      allow update: if hasPermission('locations', 'edit');
      allow delete: if hasPermission('locations', 'delete');
    }

    // Products & Inventory:
    // Read: Requires 'products.view'
    // Write: Requires 'products.add'/'products.edit'/'products.delete' or super_admin
    match /products/{document=**} {
      allow read: if hasPermission('products', 'view');
      allow create: if hasPermission('products', 'add');
      allow update: if hasPermission('products', 'edit');
      allow delete: if hasPermission('products', 'delete');
    }

    // Transactions (Sales, Purchases, Movements):
    // Read: Requires relevant module view permission
    // Write: Requires relevant add permission or super_admin
    match /transactions/{document=**} {
      allow read: if hasPermission('sales', 'view') || hasPermission('purchases', 'view') || hasPermission('movements', 'view');
      allow create: if isSuperAdmin() || hasPermission('sales', 'add') || hasPermission('purchases', 'add') || hasPermission('movements', 'transfer') || hasPermission('movements', 'adjustment') || hasPermission('movements', 'repair') || hasPermission('movements', 'melt');
      allow update, delete: if isSuperAdmin();
    }

    // Audit Logs: Readable by super admins or authorized auditors; append-only by authenticated users
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        hasPermission('users', 'view') ||
        hasPermission('archive', 'zeroBalance') ||
        hasPermission('reports', 'export')
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Absolute default deny for any other collections or paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
