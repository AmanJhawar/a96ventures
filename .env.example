# ==============================================================================
# A96 Ventures - Environment Variables Template
# Copy this file to .env.local and populate the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Browser / Client-side SDK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Optional App Check / reCAPTCHA v3 site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Optional debug token for local development with Firebase App Check
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-side API Routes)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"
# Enclose multiline private key in double quotes with \n or newline formatting
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Cloudinary Configuration (Secure Image Uploads & Optimizations)
# ------------------------------------------------------------------------------
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="a96ventures"

# ------------------------------------------------------------------------------
# 4. Optional Initial Admin Seed Credentials
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SEED_EMAIL="admin@a96ventures.com"
NEXT_PUBLIC_SEED_PASSWORD="ChangeThisPassword123!"

# ------------------------------------------------------------------------------
# 5. ISR On-Demand Cache Revalidation Secret
# ------------------------------------------------------------------------------
REVALIDATION_SECRET="your-secure-random-revalidation-token"
